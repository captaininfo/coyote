{
  "manifest_version": 3,
  "name": "Coyote Browser Extension",
  "version": "2.0.0",
  "description": "Records the pages you visit and links you click, sending them only to your local Coyote app (127.0.0.1)—nothing leaves your device.",
  "icons": {
    "16": "icons/coyote-16.png",
    "32": "icons/coyote-32.png",
    "48": "icons/coyote-48.png",
    "128": "icons/coyote-128.png"
  },

  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],

  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],

  "background": {
    "service_worker": "js/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["js/content.js"]
    }
  ],

  "action": {
    "default_icon": {
      "16": "icons/coyote-16.png",
      "32": "icons/coyote-32.png",
      "48": "icons/coyote-48.png"
    },
    "default_title": "Coyote — capturing (click to pause)"
  },

  "minimum_chrome_version": "120"
}
