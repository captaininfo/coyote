# ============================================================
# Coyote Configuration
# ============================================================
# Copy this file to .env and customize values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to git (it contains secrets)
# The .gitignore already excludes compose/.env
# ============================================================

# --- Ports (host machine) ---
COYOTE_PORT=5000
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
OLLAMA_PORT=11434
BOT_PORT=8501

# --- Neo4j Credentials ---
# IMPORTANT: Change the password!
# The UI auto-generates a secure password on first run if you leave
# this as the placeholder value below.
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD
NEO4J_AUTH=neo4j/CHANGE_ME_TO_A_SECURE_PASSWORD

# --- Data Directories (relative to compose/) ---
COYOTE_DATA_DIR=./volumes/neo4j
NEO4J_DATA_DIR=./volumes/neo4j
COYOTE_MODELS_DIR=./volumes/ollama
COYOTE_USER_DATA=./volumes/coyote
EMBEDDING_MODEL_DIR=./volumes/embedding_model
EMBEDDING_MODEL=hf

# --- Service Wiring (container names, don't change unless you know why) ---
NEO4J_URI=bolt://database:7687
COYOTE_NEO4J_URI_HOST=bolt://localhost:7687
OLLAMA_BASE_URL=http://llm:11434
LLM=mistral:7b-instruct

# --- Optional: Hypothes.is Integration ---
# Get your API token from https://hypothes.is/account/developer
# Leave commented out if you don't use Hypothes.is annotations
# HYPOTHESIS_USERNAME=your_username
# HYPOTHESIS_TOKEN=your_api_token_here

# --- Logging (optional) ---
# Set to DEBUG for verbose output (default: INFO)
# COYOTE_LOG_LEVEL=INFO
# AGENT_LOG_LEVEL=INFO
