cat > .gitignore <<'EOF'
# OS cruft
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtual envs (anywhere)
.venv*/
venv*/
*/.venv*/
*/venv*/

# Node
node_modules/

# IDE
.vscode/
.idea/

# Environment files
compose/.env

# Docker / Compose
compose/volumes/
images/**/*.tar

# Logs & archives
*.log
*.zip
*.tar
*.tar.gz
EOF
